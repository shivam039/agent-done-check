{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shivam039/agent-done-check/blob/main/schemas/config-v1.schema.json",
  "title": "Agent Done Check configuration v1",
  "description": "Verification criteria and command, Playwright, commit-bound file, or commit-bound GET-only HTTP checks accepted by Agent Done Check config version 1.",
  "type": "object",
  "required": ["version", "criteria", "checks"],
  "properties": {
    "version": { "const": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
    "env": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "additionalProperties": { "type": "string" } },
    "inheritEnv": { "$ref": "#/$defs/environmentNames" },
    "redactEnv": { "$ref": "#/$defs/environmentNames" },
    "criteria": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/criterion" } },
    "checks": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/check" } }
  },
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "environmentNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
    "criterion": {
      "type": "object",
      "required": ["id", "description"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["click", "fill", "check", "uncheck", "selectOption", "press", "expectVisible", "expectHidden", "expectText", "expectValue", "expectUrl"] },
        "selector": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "exact": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "expectUrl" } }, "required": ["action"] }, "then": { "properties": { "value": {} }, "required": ["value"] }, "else": { "properties": { "selector": {} }, "required": ["selector"] } },
        { "if": { "properties": { "action": { "enum": ["fill", "selectOption", "press", "expectText", "expectValue"] } }, "required": ["action"] }, "then": { "properties": { "value": {} }, "required": ["value"] } }
      ],
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["id", "criteria"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["command", "playwright", "file", "http"] },
        "criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
        "command": { "type": "string", "minLength": 1 },
        "expectedExitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "stdoutContains": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "stderrContains": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "stdin": { "type": "string", "maxLength": 65536 },
        "path": { "type": "string", "minLength": 1 },
        "assertion": { "enum": ["exists", "equals", "contains", "sha256"] },
        "expected": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "commitHeader": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
        "bodyContains": { "type": "string" },
        "browser": { "enum": ["chromium", "firefox", "webkit"] },
        "commitAssertion": {
          "type": "object",
          "required": ["selector"],
          "properties": { "selector": { "type": "string", "minLength": 1 }, "attribute": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "setupCommand": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/step" } },
        "waitUntil": { "enum": ["load", "domcontentloaded", "networkidle", "commit"] },
        "failOnPageError": { "type": "boolean" },
        "failOnConsoleError": { "type": "boolean" },
        "failOnRequestFailure": { "type": "boolean" },
        "failOnHttpError": { "type": "boolean" },
        "screenshot": { "type": "boolean" },
        "viewport": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1, "maximum": 16384 }, "height": { "type": "integer", "minimum": 1, "maximum": 16384 } }, "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "playwright" } }, "required": ["type"] },
          "then": { "properties": { "url": {}, "steps": {} }, "required": ["url", "steps"] },
          "else": {
            "if": { "properties": { "type": { "const": "http" } }, "required": ["type"] },
            "then": { "properties": { "url": {} }, "required": ["url"] },
            "else": {
            "if": { "properties": { "type": { "const": "file" } }, "required": ["type"] },
            "then": {
              "properties": { "path": {}, "assertion": {} },
              "required": ["path", "assertion"],
              "allOf": [
                { "if": { "properties": { "assertion": { "enum": ["equals", "contains", "sha256"] } }, "required": ["assertion"] }, "then": { "properties": { "expected": {} }, "required": ["expected"] } },
                { "if": { "properties": { "assertion": { "const": "sha256" } }, "required": ["assertion"] }, "then": { "properties": { "expected": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
                { "if": { "properties": { "assertion": { "const": "exists" } }, "required": ["assertion"] }, "then": { "not": { "required": ["expected"] } } }
              ]
            },
            "else": { "properties": { "command": {} }, "required": ["command"] }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}

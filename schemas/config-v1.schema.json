{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shivam039/agent-done-check/blob/main/schemas/config-v1.schema.json",
  "title": "Agent Done Check configuration v1",
  "description": "Verification criteria and command, Playwright, commit-bound file, or commit-bound GET-only HTTP checks accepted by Agent Done Check config version 1.",
  "type": "object",
  "required": [
    "version",
    "criteria",
    "checks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 1800000
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "inheritEnv": {
      "$ref": "#/$defs/environmentNames"
    },
    "redactEnv": {
      "$ref": "#/$defs/environmentNames"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "environmentNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "click",
            "fill",
            "check",
            "uncheck",
            "selectOption",
            "press",
            "expectVisible",
            "expectHidden",
            "expectText",
            "expectValue",
            "expectAccessibleName",
            "expectAccessibleDescription",
            "expectClass",
            "expectAttribute",
            "expectAttributeExists",
            "expectAttributeMissing",
            "expectCount",
            "expectTitle",
            "expectEnabled",
            "expectDisabled",
            "expectChecked",
            "expectUnchecked",
            "expectFocused",
            "expectUrl"
          ]
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "attribute": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "enum": ["alert", "alertdialog", "application", "article", "banner", "blockquote", "button", "caption", "cell", "checkbox", "code", "columnheader", "combobox", "complementary", "contentinfo", "definition", "deletion", "dialog", "directory", "document", "emphasis", "feed", "figure", "form", "generic", "grid", "gridcell", "group", "heading", "img", "insertion", "link", "list", "listbox", "listitem", "log", "main", "marquee", "math", "meter", "menu", "menubar", "menuitem", "menuitemcheckbox", "menuitemradio", "navigation", "none", "note", "option", "paragraph", "presentation", "progressbar", "radio", "radiogroup", "region", "row", "rowgroup", "rowheader", "scrollbar", "search", "searchbox", "separator", "slider", "spinbutton", "status", "strong", "subscript", "superscript", "switch", "tab", "table", "tablist", "tabpanel", "term", "textbox", "time", "timer", "toolbar", "tooltip", "tree", "treegrid", "treeitem"]
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S+$"
        },
        "present": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "exact": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "enum": ["expectAccessibleName", "expectAccessibleDescription"] } },
            "required": ["action"]
          },
          "then": { "properties": { "role": {} }, "required": ["role"] },
          "else": { "not": { "properties": { "role": {} }, "required": ["role"] } }
        },
        {
          "if": {
            "properties": { "action": { "const": "expectClass" } },
            "required": ["action"]
          },
          "then": {
            "properties": { "className": {}, "present": {} },
            "required": ["className", "present"],
            "not": {
              "anyOf": [
                { "properties": { "value": {} }, "required": ["value"] },
                { "properties": { "exact": {} }, "required": ["exact"] },
                { "properties": { "attribute": {} }, "required": ["attribute"] },
                { "properties": { "count": {} }, "required": ["count"] },
                { "properties": { "role": {} }, "required": ["role"] }
              ]
            }
          },
          "else": {
            "not": { "properties": { "className": {} }, "required": ["className"] }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "const": "expectAttribute" }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "attribute": {},
              "value": {}
            },
            "required": ["attribute", "value"]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["expectAttributeExists", "expectAttributeMissing"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "required": ["attribute"],
            "not": {
              "anyOf": [
                { "properties": { "value": {} }, "required": ["value"] },
                { "properties": { "exact": {} }, "required": ["exact"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": { "const": "expectCount" }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "count": {}
            },
            "required": ["count"]
          },
          "else": {
            "not": {
              "required": ["count"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["expectUrl", "expectTitle"]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "value": {}
            },
            "required": [
              "value"
            ]
          },
          "else": {
            "properties": {
              "selector": {}
            },
            "required": [
              "selector"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "fill",
                  "selectOption",
                  "press",
                  "expectText",
                  "expectValue",
                  "expectAccessibleName",
                  "expectAccessibleDescription",
                  "expectAttribute",
                  "expectTitle"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "value": {}
            },
            "required": [
              "value"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "criteria"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "command",
            "playwright",
            "file",
            "http"
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1800000
        },
        "command": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          ]
        },
        "expectedExitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stdoutContains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stderrContains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stdoutEquals": {
          "type": "string",
          "maxLength": 65536
        },
        "stderrEquals": {
          "type": "string",
          "maxLength": 65536
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "stdin": {
          "type": "string",
          "maxLength": 65536
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "enum": [
            "exists",
            "equals",
            "contains",
            "sha256",
            "jsonPointerEquals",
            "jsonPointerExists"
          ]
        },
        "pointer": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "expected": {},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "commitHeader": {
          "type": "string",
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
        },
        "bodyContains": {
          "type": "string"
        },
        "bodyEquals": {
          "type": "string",
          "maxLength": 1048576
        },
        "responseHeaders": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
            "maxLength": 256
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "requiredResponseHeaders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" }
        },
        "expectedContentType": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+/[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
        "browser": {
          "enum": [
            "chromium",
            "firefox",
            "webkit"
          ]
        },
        "commitAssertion": {
          "type": "object",
          "required": [
            "selector"
          ],
          "properties": {
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "attribute": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "setupCommand": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "waitUntil": {
          "enum": [
            "load",
            "domcontentloaded",
            "networkidle",
            "commit"
          ]
        },
        "failOnPageError": {
          "type": "boolean"
        },
        "failOnConsoleError": {
          "type": "boolean"
        },
        "failOnRequestFailure": {
          "type": "boolean"
        },
        "failOnHttpError": {
          "type": "boolean"
        },
        "screenshot": {
          "type": "boolean"
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          },
          "additionalProperties": true
        },
        "bodySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "bodyJsonPointerEquals": {
          "type": "object",
          "required": [
            "pointer",
            "expected"
          ],
          "properties": {
            "pointer": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            "expected": {}
          },
          "additionalProperties": false
        },
        "bodyJsonPointerExists": {
          "type": "object",
          "required": ["pointer"],
          "properties": {
            "pointer": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "additionalProperties": false
        },
        "expectedStatuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "expectedExitCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "requiredResponseHeaders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "playwright"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "url": {},
              "steps": {}
            },
            "required": [
              "url",
              "steps"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "const": "http"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "url": {}
              },
              "required": [
                "url"
              ]
            },
            "else": {
              "if": {
                "properties": {
                  "type": {
                    "const": "file"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "properties": {
                  "path": {},
                  "assertion": {},
                  "pointer": {}
                },
                "required": [
                  "path",
                  "assertion"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "assertion": {
                          "enum": [
                            "equals",
                            "contains",
                            "sha256"
                          ]
                        }
                      },
                      "required": [
                        "assertion"
                      ]
                    },
                    "then": {
                      "properties": {
                        "expected": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "expected"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "assertion": {
                          "const": "sha256"
                        }
                      },
                      "required": [
                        "assertion"
                      ]
                    },
                    "then": {
                      "properties": {
                        "expected": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "assertion": {
                          "const": "exists"
                        }
                      },
                      "required": [
                        "assertion"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "expected"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "assertion": {
                          "enum": [
                            "jsonPointerEquals",
                            "jsonPointerExists"
                          ]
                        }
                      },
                      "required": [
                        "assertion"
                      ]
                    },
                    "then": {
                      "properties": {
                        "pointer": {}
                      },
                      "required": [
                        "pointer"
                      ]
                    },
                    "else": {
                      "properties": {
                        "pointer": {}
                      },
                      "not": {
                        "required": [
                          "pointer"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "assertion": {
                          "const": "jsonPointerEquals"
                        }
                      },
                      "required": [
                        "assertion"
                      ]
                    },
                    "then": {
                      "properties": {
                        "expected": {}
                      },
                      "required": [
                        "expected"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "assertion": {
                          "const": "jsonPointerExists"
                        }
                      },
                      "required": [
                        "assertion"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "expected"
                        ]
                      }
                    }
                  }
                ]
              },
              "else": {
                "properties": {
                  "command": {}
                },
                "required": [
                  "command"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectedStatuses": {}
            },
            "required": [
              "expectedStatuses"
            ]
          },
          "then": {
            "not": {
              "properties": {
                "expectedStatus": {}
              },
              "required": [
                "expectedStatus"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectedStatuses": {}
            },
            "required": [
              "expectedStatuses"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "http"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "expectedExitCodes": {}
            },
            "required": [
              "expectedExitCodes"
            ]
          },
          "then": {
            "not": {
              "properties": {
                "expectedExitCode": {}
              },
              "required": [
                "expectedExitCode"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectedExitCodes": {}
            },
            "required": [
              "expectedExitCodes"
            ]
          },
          "then": {
            "not": {
              "properties": {
                "type": {
                  "enum": [
                    "playwright",
                    "file",
                    "http"
                  ]
                }
              },
              "required": [
                "type"
              ]
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}

{
  "version": 1,
  "timeoutMs": 10000,
  "criteria": [
    {
      "id": "deployment",
      "description": "The deployment serves the verified commit and expected health data."
    }
  ],
  "checks": [
    {
      "id": "health-endpoint",
      "type": "http",
      "url": "https://example.invalid/health",
      "bodyContains": "healthy",
      "criteria": [
        "deployment"
      ],
      "maxBodyBytes": 65536,
      "requiredResponseHeaders": ["content-type"],
      "expectedStatuses": [
        200,
        201
      ]
    },
    {
      "id": "health-data",
      "type": "http",
      "url": "https://example.invalid/health.json",
      "bodyJsonPointerEquals": {
        "pointer": "/status",
        "expected": "healthy"
      },
      "criteria": [
        "deployment"
      ]
    }
  ]
}

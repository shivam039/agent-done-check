{
  "version": 1,
  "timeoutMs": 120000,
  "criteria": [
    { "id": "primary-flow", "description": "The primary user flow works in the application." },
    { "id": "regressions", "description": "Existing automated checks remain green." }
  ],
  "checks": [
    {
      "id": "primary-flow-browser",
      "command": "npm ci && npm run test:e2e -- --grep primary-flow",
      "criteria": ["primary-flow"]
    },
    {
      "id": "existing-checks",
      "command": "npm ci && npm test",
      "criteria": ["regressions"]
    }
  ]
}
